[Unit]
Description=Sparkes Apple Health upload receiver
After=network.target

[Service]
Type=simple
User=sparkes
Group=sparkes
WorkingDirectory=/opt/project-sparkes
ExecStart=/opt/project-sparkes/.venv-health/bin/uvicorn health_extract.receiver:create_app --factory --host 127.0.0.1 --port 8765 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/project-sparkes/data/health

[Install]
WantedBy=multi-user.target
