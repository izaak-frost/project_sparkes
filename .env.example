# Store private values in .env on OCI, not in Git.
# Garmin credentials are optional for scheduled runs after saving valid tokens.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKENS=data/garmin/tokens
# Choose the first day of history you need; required for Garmin ingestion.
START_DATE=
SLEEP_REFRESH_DAYS=3
# Required for the existing sleep Google Sheets update.
COACHING_START_DATE=
GOOGLE_SERVICE_ACCOUNT_FILE=support/credentials/google-service-account.json
GOOGLE_SHEET_ID=
HEVY_API_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTH_UPLOAD_TOKEN=
HEALTH_TIMEZONE=Europe/London
HEALTH_MAX_UPLOAD_AGE_HOURS=48
# Optional absolute locations for generated data:
# SPARKES_DATA_DIR=/opt/project-sparkes/data
# HEALTH_DATA_DIR=/opt/project-sparkes/data/health
# HEVY_DATA_DIR=/opt/project-sparkes/data/hevy
